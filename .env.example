# ── Cloudflare D1 ────────────────────────────────────────────────────────────
# Option A (recommended on Workers): the native `DB` binding in wrangler.jsonc.
# Nothing to put here — just set AR_D1_BINDING=1 (already in wrangler.jsonc)
# and replace REPLACE_WITH_YOUR_D1_DATABASE_ID with your real database id.
#
# Option B (any host, including plain Node/Next hosting): D1 over its REST API.
# With these three set, src/lib/storage.ts automatically uses Cloudflare D1.
# Leave them unset to keep the zero-config local data/*.json fallback.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# Needs "D1:Edit" permission on the account. NEVER expose this to the browser.
CF_API_TOKEN=

# ── Admin panel ──────────────────────────────────────────────────────────
# Optional. If ADMIN_PASS is set, unlocking the vault gate also requires
# that password (sent as { pass } alongside the riddle key). Leave unset
# for riddle-key-only unlocking.
# ADMIN_PASS=
# Optional. Secret used to sign admin session cookies. If unset, a random
# secret is generated per server process (sessions do not survive restarts).
# ADMIN_SESSION_SECRET=
